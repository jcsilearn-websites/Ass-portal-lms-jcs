# Environment variables example
# Copy this file to .env and fill in real values there. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# --- Database (Supabase Postgres) ---
DATABASE_URL=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- JWT ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Redis (Upstash) ---
REDIS_URL=

# --- Judge0 ---
JUDGE0_BASE_URL=
JUDGE0_API_KEY=

# --- NVIDIA (chatbot, Phase 6a) ---
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Temporary kill switch (UI cleanup phase, item 5) — set to false to reject
# POST /chatbot/ask with 503 before it ever runs. Defaults to true (enabled)
# when unset.
CHATBOT_ENABLED=true
